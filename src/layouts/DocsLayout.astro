---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocNav from '../components/DocNav.astro';
import TOC from '../components/TOC.astro';
import Install from '../components/Install.astro';
import Wordmark from '../components/Wordmark.astro';
import { getProject, languages, projectHref } from '../data/projects';

interface Props {
  project: string;
  title: string;
  description?: string;
  slug: string;
  headings: MarkdownHeading[];
}
const { project, title, description, slug, headings } = Astro.props as Props;

const meta = getProject(project)!;
const language = languages[meta.lang];
const pageTitle = slug === 'index' ? meta?.displayName ?? project : `${title} · ${meta?.displayName ?? project}`;
const desc = description ?? meta?.tagline ?? `Documentation for ${meta?.displayName ?? project}.`;

const siteOrigin = (Astro.site ?? new URL('https://gems.marcosz.com.br')).origin;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: language.name,
      item: `${siteOrigin}/${meta.lang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: meta?.displayName ?? project,
      item: `${siteOrigin}${projectHref(meta)}`,
    },
    ...(slug !== 'index'
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: title,
            item: `${siteOrigin}${projectHref(meta, slug)}`,
          },
        ]
      : []),
  ],
};

const techArticleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: desc,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Marcos G. Zimmermann',
    url: 'https://github.com/marcosgz',
  },
  publisher: {
    '@type': 'Person',
    name: 'Marcos G. Zimmermann',
    url: 'https://github.com/marcosgz',
  },
  isPartOf: meta
    ? {
        '@type': 'SoftwareSourceCode',
        name: meta.displayName,
        codeRepository: meta.repo,
        programmingLanguage: language.name,
      }
    : undefined,
  about: meta?.tagline,
};

const keywords = meta ? [meta.name, meta.displayName, language.name, 'documentation', title] : [title];
---

<BaseLayout
  title={pageTitle}
  description={desc}
  lang={meta.lang}
  ogType="article"
  section={meta.displayName}
  keywords={keywords}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(techArticleJsonLd)} />

  <div class="wrap docs-shell">
    <DocNav project={meta} currentSlug={slug} />

    <article class="docs-article">
      <header class="docs-article__head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a class="crumbs__lang" href={`/${meta.lang}/`}>{language.name}</a>
          <span aria-hidden="true">/</span>
          {slug === 'index' ? <span aria-current="page">{meta.displayName}</span> : <a href={projectHref(meta)}>{meta.displayName}</a>}
          {slug !== 'index' && (
            <>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{title}</span>
            </>
          )}
        </nav>
        <h1 class="docs-article__title">
          {slug !== 'index' ? title : meta.wordmark ? <Wordmark project={meta} /> : meta.displayName}
        </h1>
        {slug === 'index' && (
          <>
            <p class="docs-article__lede">{meta.tagline}</p>
            <Install project={meta} />
            <p class="lib__links">
              <a href={meta.repo}>Source</a>
              <a href={meta.registryUrl}>{language.registry}</a>
            </p>
          </>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="docs-article__foot">
        <a href={meta.source}>Edit or read this page on GitHub</a>
      </footer>
    </article>

    <div class="docs-shell__rail">
      <TOC headings={headings} />
    </div>
  </div>
</BaseLayout>
