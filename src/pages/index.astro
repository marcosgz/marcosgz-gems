---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import { familiesFor, languages, projectHref, type Lang } from '../data/projects';

const langs: Lang[] = ['ruby', 'elixir'];
---

<BaseLayout title="marcosgz · projects">
  <div class="wrap">
    <section class="intro">
      <h1>Libraries for Ruby and Elixir apps.</h1>
      <p>
        Search indexing, messaging, multi-step workflows, sitemaps and multi-tenant sites. Each one is small,
        documented and MIT licensed.
      </p>
    </section>

    <div class="split">
      {langs.map((lang) => (
        <section class="lang" data-lang={lang} aria-label={languages[lang].name}>
          <Band lang={lang} link />
          <ul class="lang__list">
            {familiesFor(lang).map(({ lead, members }) => (
              <li class="lang__item">
                <a class="lang__link" href={projectHref(lead)}>
                  <h3>{lead.displayName}</h3>
                  {members.length > 0 && <span class="lang__extra">+{members.length} more</span>}
                  <p>{lead.tagline}</p>
                </a>
              </li>
            ))}
          </ul>
          <a class="lang__foot" href={`/${lang}/`}>
            All {languages[lang].name} {lang === 'ruby' ? 'gems' : 'packages'}
          </a>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
