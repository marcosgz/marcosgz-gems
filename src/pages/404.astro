---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="There is no page at this address." noindex>
  <section class="wrap">
    <div class="nf">
      <h1>There is no page at this address.</h1>
      <p>It may have moved when the libraries were split by language. Pick a language to find it again.</p>
      <ul>
        <li><a href="/ruby/">Ruby libraries</a></li>
        <li><a href="/elixir/">Elixir libraries</a></li>
        <li><a href="/">Home</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
