---
import { render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docPaths } from '../../data/docs';

export async function getStaticPaths() {
  return docPaths('ruby');
}

const { entry } = Astro.props as { entry: CollectionEntry<'docs'> };
const { Content, headings } = await render(entry);
---

<DocsLayout project={entry.data.project} title={entry.data.title} slug={entry.data.slug} headings={headings}>
  <Content />
</DocsLayout>
