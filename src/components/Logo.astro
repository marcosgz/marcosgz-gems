---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props as Props;
const line = { fill: 'none', stroke: 'currentColor', 'stroke-width': 7, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

{project.logo === 'mark:lepus' ? (
  <svg class="family__logo" viewBox="1 0 64 64" aria-hidden="true">
    <path d="M14 5 V42 A14 14 0 0 0 28 56 H42 A10 10 0 0 0 42 36 H28 V15" {...line} />
    <circle cx="40.5" cy="46" r="4" fill="#f2a30f" />
  </svg>
) : project.logo === 'mark:sitemaps' ? (
  <svg class="family__logo" viewBox="0 1 64 64" aria-hidden="true">
    <path d="M24 10 L12 28 L32 57 L52 28 L40 10" {...line} />
    <circle cx="32" cy="28" r="6" fill="#1f9d6b" />
  </svg>
) : project.logo === 'mark:multitenancy' ? (
  <svg class="family__logo" viewBox="-2 0 64 64" aria-hidden="true">
    <path d="M8 32 H22 M22 32 C29 32 29 14 36 14 M22 32 H36 M22 32 C29 32 29 50 36 50" {...line} />
    <circle cx="50" cy="14" r="5.5" fill="currentColor" />
    <circle cx="50" cy="32" r="5.5" fill="#4a7bec" />
    <circle cx="50" cy="50" r="5.5" fill="currentColor" />
  </svg>
) : project.logo ? (
  <img class="family__logo" src={project.logo} alt="" width="52" height="52" />
) : (
  <span class="family__logo family__logo--letter" aria-hidden="true">{project.displayName.charAt(0)}</span>
)}
