---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { getProject, projectHref, projects, type Project } from '../data/projects';

interface Props {
  project: Project;
  currentSlug: string;
}
const { project, currentSlug } = Astro.props as Props;

const pages = (await getCollection('docs'))
  .filter((e) => e.data.project === project.id)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const lead = project.family ? getProject(project.family)! : project;
const family = [lead, ...projects.filter((p) => p.family === lead.id)];
---

<aside class="doc-nav" aria-label="Documentation">
  <a class="doc-nav__project" href={projectHref(project)}>
    <Logo project={lead} />
    <strong>{project.displayName}</strong>
  </a>

  {pages.length > 1 && (
    <nav aria-label={`${project.displayName} pages`}>
      <ol class="doc-nav__pages">
        {pages.map((page) => (
          <li>
            <a href={projectHref(project, page.data.slug)} aria-current={page.data.slug === currentSlug ? 'page' : undefined}>
              {page.data.slug === 'index' ? 'Overview' : page.data.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  {family.length > 1 && (
    <nav class="doc-nav__family" aria-labelledby="family-title">
      <h2 id="family-title">{lead.displayName} family</h2>
      <ul>
        {family.map((member) => (
          <li>
            <a href={projectHref(member)} aria-current={member.id === project.id ? 'true' : undefined}>
              {member.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</aside>
